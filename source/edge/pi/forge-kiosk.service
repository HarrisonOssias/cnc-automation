# /etc/systemd/system/forge-kiosk.service
# Full-screen Chromium on the Pi's display, inside the cage Wayland compositor.
[Unit]
Description=Forge kiosk
After=forge-agent.service systemd-user-sessions.service
Wants=forge-agent.service
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
UtmpIdentifier=tty1
# boot.html waits for the agent, then redirects to it (avoids a stuck error page at boot).
ExecStart=/usr/bin/cage -- chromium --kiosk --incognito --noerrdialogs --disable-session-crashed-bubble --disk-cache-dir=/tmp/chromium-cache file:///opt/forge/current/source/edge/pi/boot.html
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
